{
  "name": "prograin-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual Prograin website built with Next.js",
  "scripts": {
    "format": "prettier --write src scripts docs .github README.md package.json vercel.json site.webmanifest.json next.config.mjs eslint.config.mjs",
    "format:check": "prettier --check src scripts docs .github README.md package.json vercel.json site.webmanifest.json next.config.mjs eslint.config.mjs",
    "build": "node scripts/prepare-next.mjs && next build",
    "package": "npm run build && npm run check",
    "check": "npm run check:structure && node scripts/check-build.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "test:performance": "node scripts/check-performance.mjs",
    "test:students": "node scripts/check-students.mjs",
    "test:admin": "node scripts/check-academy-admin.mjs",
    "test:admin:courses": "node scripts/check-admin-courses.mjs",
    "test:enrollment-status": "node scripts/check-enrollment-status.mjs",
    "test:profile:email": "node scripts/check-profile-email.mjs",
    "test:email:otp": "node scripts/check-email-otp.mjs",
    "test:email:internal": "node scripts/check-internal-email.mjs",
    "test:student:links": "node scripts/check-student-links.mjs",
    "test:course-resources": "node scripts/check-course-resources.mjs",
    "test:student-runtime": "node scripts/check-student-runtime.mjs",
    "test:table-sorting": "node scripts/check-table-sorting.mjs",
    "test:validation": "node scripts/check-validation.mjs",
    "test:security": "node scripts/check-security.mjs",
    "test:security:db": "node scripts/check-security-database.mjs",
    "test:security:api": "node scripts/check-backend-guards.mjs",
    "test:updates": "node scripts/check-updates.mjs",
    "images:social": "node scripts/generate-social-images.mjs",
    "test:browser": "node scripts/check-site.mjs && node scripts/check-seo-browser.mjs && node scripts/check-interactions.mjs && node scripts/check-ui.mjs",
    "dev": "node scripts/prepare-next.mjs && next dev -H 127.0.0.1 -p 4173",
    "preview": "next start -H 127.0.0.1 -p 4173",
    "lint": "eslint src",
    "auth:migrate": "node --env-file-if-exists=.env scripts/student-auth-migrate.mjs",
    "student:add": "node --env-file-if-exists=.env scripts/student-add.mjs",
    "student:demo": "node --env-file-if-exists=.env scripts/student-demo.mjs",
    "student:weekly": "node --env-file-if-exists=.env scripts/student-weekly.mjs",
    "student:notifications": "node --env-file-if-exists=.env scripts/student-notifications.mjs",
    "test:notifications:delivery": "node scripts/check-notification-delivery.mjs",
    "test:notifications:drain": "node scripts/check-notification-drain.mjs",
    "test:notifications:scheduler": "node scripts/check-notification-scheduler.mjs",
    "test:notifications:events": "node scripts/check-student-notifications.mjs",
    "test:notifications:ui": "node scripts/check-notification-ui.mjs",
    "test:notifications:worker": "node scripts/check-notification-worker.mjs",
    "db:migrate": "npm run auth:migrate",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "test:scoring": "node scripts/check-student-scoring.mjs",
    "test:weekly": "node scripts/check-student-weekly.mjs",
    "test:weekly:ui": "node scripts/check-weekly-ui.mjs",
    "test:course-ranks": "node scripts/check-course-rankings.mjs",
    "test:academy": "node scripts/check-academy.mjs",
    "test:academy:app": "node scripts/check-academy-app-worker.mjs && node scripts/check-academy-app.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "16.4.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.8",
    "js-yaml": "^5.5.0",
    "lightningcss": "1.33.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "purgecss": "9.1.0",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "better-auth": "1.7.25",
    "chart.js": "4.6.1",
    "class-variance-authority": "0.7.1",
    "drizzle-orm": "0.45.4",
    "lucide": "^1.77.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "p-retry": "9.0.0",
    "pg": "8.23.1",
    "rate-limiter-flexible": "11.5.0",
    "raw-body": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intersection-observer": "^11.0.1",
    "resend": "^6.39.0",
    "swr": "^2.5.1",
    "web-push": "^4.0.0",
    "workbox-window": "^7.4.1",
    "zod": "4.6.7"
  }
}
